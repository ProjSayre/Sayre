{
  "name": "@sayre/core",
  "version": "0.1.0",
  "private": true,
  "description": "Node/TypeScript API + service layer + Graph Query Service + BullMQ integration workers.",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker:git": "tsx src/integrations/git/worker.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/mcp-interop/tsconfig.json",
    "lint": "eslint . --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../infra/.env --import tsx src/db/migrate.ts",
    "db:migrate:ci": "node --import tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:integration": "vitest run",
    "test:mcp-interop": "vitest run test/mcp-interop",
    "mcp-interop:local": "tsx test/mcp-interop/cli.ts",
    "test:rls": "node --env-file=../../infra/.env --import tsx --test src/db/rls.test.ts",
    "test:rls:acceptance": "node --env-file=../../infra/.env --import tsx --test src/db/rls_acceptance.tester.test.ts",
    "test:rls:ci": "node --import tsx --test src/db/rls.test.ts",
    "test:rls:acceptance:ci": "node --import tsx --test src/db/rls_acceptance.tester.test.ts",
    "worker:tickets": "tsx src/integrations/tickets/worker.ts",
    "worker:tickets-poll": "tsx src/integrations/tickets/pollWorker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "3.1088.x",
    "@aws-sdk/client-sqs": "3.1088.x",
    "@modelcontextprotocol/sdk": "1.29.x",
    "@opentelemetry/api": "1.9.x",
    "@opentelemetry/exporter-prometheus": "0.220.x",
    "@opentelemetry/sdk-metrics": "2.9.x",
    "@sayre/config": "^0.1.0",
    "@sayre/shared-types": "^0.1.0",
    "bullmq": "5.28.x",
    "drizzle-orm": "0.38.x",
    "express": "4.21.x",
    "ioredis": "5.4.x",
    "jsonwebtoken": "9.0.2",
    "neo4j-driver": "5.26.x",
    "pg": "8.13.x",
    "zod": "4.4.x"
  },
  "devDependencies": {
    "@types/express": "4.17.x",
    "@types/jsonwebtoken": "9.0.x",
    "@types/node": "20.x",
    "@types/pg": "8.11.x",
    "@typescript-eslint/eslint-plugin": "7.x",
    "@typescript-eslint/parser": "7.x",
    "drizzle-kit": "0.30.x",
    "eslint": "8.57.x",
    "tsx": "4.x",
    "typescript": "5.5.x",
    "vitest": "2.1.x"
  },
  "engines": {
    "node": ">=20 <21"
  }
}
