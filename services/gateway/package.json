{
  "name": "@sayre/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime Service: WebSocket gateway + Redis pub/sub fan-out of accepted graph.updated events (docs/architecture.md).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1088.x",
    "@sayre/config": "^0.1.0",
    "@sayre/core": "^0.1.0",
    "@sayre/shared-types": "^0.1.0",
    "ioredis": "5.4.x",
    "ws": "8.18.x"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/ws": "8.18.x",
    "@typescript-eslint/eslint-plugin": "7.x",
    "@typescript-eslint/parser": "7.x",
    "eslint": "8.57.x",
    "tsx": "4.x",
    "typescript": "5.5.x",
    "vitest": "2.1.x"
  },
  "engines": {
    "node": ">=20 <21"
  }
}
