{
  "name": "Sayre (dev)",
  "url": "https://__SAYRE_HOST__",
  "hook_attributes": {
    "url": "https://__SAYRE_HOST__/webhooks/github"
  },
  "redirect_url": "https://__SAYRE_HOST__/integrations/github/callback",
  "callback_urls": [
    "https://__SAYRE_HOST__/integrations/github/callback"
  ],
  "request_oauth_on_install": true,
  "public": true,
  "default_permissions": {
    "contents": "read",
    "members": "read",
    "metadata": "read",
    "pull_requests": "read"
  },
  "default_events": [
    "push",
    "pull_request",
    "create",
    "delete",
    "installation",
    "installation_repositories"
  ]
}
