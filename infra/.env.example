# Sayre local configuration template. Placeholders only: copy to infra/.env,
# replace every <...> value locally, and never commit the populated file.
# Secret consumers resolve the canonical env://NAME reference through @sayre/config
# or sayre_workers.config; operators store the raw pre-provisioned value under NAME.

# --- Non-secret application configuration ---
NODE_ENV=development
SAYRE_ENV=development
CORE_PORT=4000
MCP_TOKEN_PEPPER_VERSION=1
# Exact browser origins permitted to call POST /mcp. Native MCP clients normally
# omit Origin and remain allowed. Keep empty unless browser MCP is intentional.
MCP_ALLOWED_ORIGINS=[]
# `org_dev_local` (the default) is fine for routes that only need *some* stable
# dev org string (e.g. src/http/tenantContext.ts). It is NOT a UUID, so it does
# NOT satisfy `withOrgContext`'s UUID check (services/core/src/db/client.ts) —
# any route that performs a real tenant-scoped Postgres write in dev/test (e.g.
# W1-06's `GET /integrations/github/callback`) needs DEV_ORG_ID overridden to a
# real `organizations.id` UUID that actually exists in the local DB. The fixed
# dev-seed org UUID below is that value: seed it once with
#   psql "$DATABASE_ADMIN_URL" -c "INSERT INTO organizations (id, name, slug) VALUES ('00000000-0000-4000-8000-000000000001', 'Sayre Dev Org', 'sayre-dev') ON CONFLICT (id) DO NOTHING;"
# then set DEV_ORG_ID=00000000-0000-4000-8000-000000000001 locally when
# exercising the GitHub App install flow end-to-end (see infra/github-app/README.md).
DEV_ORG_ID=org_dev_local
# Dev/test-only synthetic session subject (services/core/src/services/authService.ts's
# devSessionContext()) — used only when NODE_ENV is 'development' or 'test' and no
# Authorization header is present; fails closed in production.
DEV_USER_ID=user_dev_local

# --- Postgres / pgvector ---
POSTGRES_USER=sayre_dev
POSTGRES_DB=sayre_dev
POSTGRES_PASSWORD=<local-postgres-password>
DATABASE_ADMIN_URL=<postgres-admin-dsn>
DATABASE_RUNTIME_URL=<postgres-non-owner-nobypassrls-dsn>

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<local-neo4j-password>
NEO4J_AUTH=<neo4j-user-slash-password>

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=<redis-password-when-auth-is-enabled>

# --- AWS / SQS + SNS (LocalStack values remain local placeholders) ---
AWS_REGION=us-east-1
SQS_ENDPOINT_URL=http://localhost:4566
SNS_ENDPOINT_URL=http://localhost:4566
MESSAGING_INTEGRATION_REQUIRED=false
AWS_ACCESS_KEY_ID=<localstack-access-key>
AWS_SECRET_ACCESS_KEY=<localstack-secret-key>
# AWS_SESSION_TOKEN=<temporary-session-token>
SQS_INGESTION_QUEUE=ingestion.fifo
SNS_GRAPH_UPDATED_TOPIC=graph-updated
SQS_GRAPH_UPDATED_REALTIME_QUEUE=graph-updated-realtime
SQS_ENRICHMENT_DEFAULT_QUEUE=enrichment-default
SQS_ENRICHMENT_PRIORITY_QUEUE=enrichment-onboarding-priority
SQS_EMBEDDING_UPSERTS_QUEUE=embedding-upserts
SQS_SELFTEST_QUEUE=w0-04-selftest
# CH-03: "Ask Sayre" turn hand-off — services/core produces, CH-04's Python
# worker consumes. Documentation parity with the other queue names above; the
# name itself is a code constant (services/core/src/queue/sqs.ts's
# CHAT_TURNS_QUEUE, services/workers/messaging/sqs_client.py's
# CHAT_TURNS_QUEUE), not read from packages/config CONFIG_NAMES.
SQS_CHAT_TURNS_QUEUE=chat-turns.fifo

# --- Realtime Service (services/gateway; W2-03) ---
GATEWAY_PORT=4100
GATEWAY_REDIS_CHANNEL=sayre:graph.updated
# Internal-only base URL the gateway uses to reach Core's
# POST /internal/realtime/graph-delta endpoint (never exposed to the public
# internet in a real deployment — see services/core/src/routes/realtimeInternal.ts).
CORE_INTERNAL_BASE_URL=http://localhost:4000
# SQS_GRAPH_UPDATED_REALTIME_QUEUE, REDIS_HOST/REDIS_PORT/REDIS_PASSWORD, and
# SQS_ENDPOINT_URL/AWS_* above are shared with services/core and already listed
# in the "Non-secret application configuration"/"Redis"/"AWS" sections.

# --- Jira Cloud OAuth 3LO connect flow (W3-10) ---
# Per-org connect flow — each org's own access/refresh tokens live encrypted in
# Postgres (jira_connections), never in this file. JIRA_BASE_URL above is
# DEPRECATED FOR SYNC: the jira-sync worker now resolves its API base
# per-org/per-job via getOrgSecret/resolveJiraConnectionContext, not this
# global value (kept only for any other non-per-org consumer that may still
# reference it). JIRA_OAUTH_CLIENT_ID / JIRA_OAUTH_CALLBACK_URL come from the
# Atlassian "OAuth 2.0 (3LO)" app registration and must exactly match the
# callback URL registered there — same per-environment provisioning posture as
# the GitHub App fields above.
JIRA_OAUTH_CLIENT_ID=<jira-oauth-3lo-client-id>
JIRA_OAUTH_CALLBACK_URL=<your-public-core-url>/integrations/jira/callback

# --- GitHub App (W1-06 install flow) ---
# GITHUB_APP_SLUG / GITHUB_APP_ID / GITHUB_APP_CLIENT_ID come from the GitHub
# "Create GitHub App from manifest" flow (infra/github-app/manifest.json) — see
# infra/github-app/README.md for per-environment recreation. Non-secret; the
# matching GITHUB_APP_PRIVATE_KEY / GITHUB_APP_CLIENT_SECRET secrets live in the
# "Pre-provisioned application secrets" section below.
GITHUB_APP_SLUG=<github-app-slug>
GITHUB_APP_ID=<github-app-numeric-id>
GITHUB_APP_CLIENT_ID=<github-app-oauth-client-id>
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEB_BASE_URL=https://github.com
GITHUB_POST_INSTALL_REDIRECT_URL=/settings/integrations

# --- GitHub "Sign in with GitHub" login/signup (AUTH-01) ---
# Reuses the SAME GitHub App OAuth credentials as the install flow above
# (GITHUB_APP_CLIENT_ID / GITHUB_APP_CLIENT_SECRET) via a user-to-server OAuth
# flow instead of the App-to-server installation flow. GitHub Apps share ONE
# list of callback URLs across all flows -- there is no separately-labeled
# "user authorization" field. Add a SECOND entry to that same callback-URL list
# (alongside the install flow's `/integrations/github/callback`) for
# `{core public base}/auth/github/callback` -- in dev, an ngrok (or equivalent)
# tunnel to CORE_PORT, exactly like the install flow's callback URL constraint.
# Because the App now has more than one registered callback URL, GitHub does
# NOT infer which one an authorize request should use (it silently falls back
# to the first one in the list) -- GITHUB_LOGIN_CALLBACK_URL below must be set
# to that exact same URL and is sent as an explicit `redirect_uri` param to
# disambiguate it. Web completion page the core callback redirects the browser
# to, with the session token in the URL fragment (#token=...) — never a query
# string.
GITHUB_LOGIN_COMPLETE_REDIRECT_URL=/auth/complete
# Must exactly match the login callback URL registered on the GitHub App (see
# above) -- e.g. https://<your-ngrok-subdomain>.ngrok-free.app/auth/github/callback
GITHUB_LOGIN_CALLBACK_URL=<your-public-core-url>/auth/github/callback

# --- Telemetry ---
OTEL_METRICS_EXPORTER=prometheus
METRICS_PORT=9464
METRICS_ADDR=0.0.0.0

# --- Pre-provisioned application secrets (future consumers; see SECRETS.md) ---
JWT_SIGNING_KEY=<jwt-signing-material>
GITHUB_APP_PRIVATE_KEY=<github-app-private-key>
GITHUB_APP_CLIENT_SECRET=<github-app-oauth-client-secret>
GITHUB_WEBHOOK_SECRET=<github-webhook-secret>
JIRA_OAUTH_CLIENT_SECRET=<jira-oauth-client-secret>
# W3-10: per-org Jira access/refresh tokens are no longer pre-provisioned env
# secrets (removed from SECRET_NAMES) — they are minted by the in-product
# Connect flow and stored encrypted in Postgres. JIRA_TOKEN_ENC_KEY is the
# AES-256-GCM key (32 raw bytes, base64-encoded) that encrypts them at rest.
JIRA_TOKEN_ENC_KEY=<base64-32-byte-aes-256-key>
LINEAR_OAUTH_CLIENT_SECRET=<linear-oauth-client-secret>
LINEAR_ACCESS_TOKEN=<linear-access-token>
LINEAR_REFRESH_TOKEN=<linear-refresh-token>
ANTHROPIC_API_KEY=<anthropic-api-key>
OPENAI_API_KEY=<openai-api-key>
MCP_TOKEN_PEPPER=<mcp-token-hmac-pepper>

# --- W3-09 approved self-hosted model endpoints (non-secret allowlist) ---
# JSON array. Each entry is bound to exact org UUIDs and one or both purposes.
# Private/internal and plain-HTTP endpoints require explicit operator opt-ins.
# The browser receives only id/label, never the URL, and cannot add an entry.
MODEL_PROVIDER_ENDPOINT_CATALOG=[]

# --- W4-01 container-only Onboarding setup execution ---
# Required before the execute endpoint is usable. Mutable tags are rejected.
ONBOARDING_SANDBOX_IMAGE=registry.example/sayre/onboarding@sha256=<64-lowercase-hex>
ONBOARDING_SANDBOX_RUNTIME=docker
ONBOARDING_SANDBOX_TIMEOUT_MS=30000
ONBOARDING_SANDBOX_MAX_OUTPUT_BYTES=32768

# --- Graph-store metrics (W0-08) ---
# No new variables required: the synthetic-load script's real Neo4j driver reuses
# NEO4J_URI/NEO4J_USER/NEO4J_PASSWORD above (via neo4j_driver_from_env()), and the
# graph metrics ride the SAME shared OTEL_METRICS_EXPORTER/METRICS_PORT/METRICS_ADDR
# provider as the vector-store metrics (one MeterProvider, one /metrics server).
