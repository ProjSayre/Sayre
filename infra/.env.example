# Local datastore credentials template — placeholders only, no real secrets.
# Per .claude/rules/security-multitenancy.md: secrets (GitHub App keys, Jira/Linear
# OAuth tokens, etc.) never live in a config file like this one — this file only
# seeds local dev containers with non-production placeholder values.

# --- Postgres (pgvector/pgvector:pg16) ---
POSTGRES_USER=sayre_dev
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=sayre_dev

# Admin/superuser DSN for local dev/CI migrations + the RLS test's setup/seed
# connection (superuser bypasses RLS by design — see services/core/drizzle/0001_*).
# Tenant-scoped app traffic never connects as this role; see withOrgContext /
# the sayre_app runtime role in services/core/drizzle/0001_*_rls_and_role.sql.
DATABASE_URL=postgresql://sayre_dev:changeme_local_only@localhost:5432/sayre_dev

# --- Neo4j (neo4j:5.24-community) ---
# Format: <username>/<password> (consumed by the container itself)
NEO4J_AUTH=neo4j/changeme_local_only

# Bolt URI + split user/password consumed by the Python `neo4j` driver
# (services/workers/sayre_workers/graph_migrations/runner.py and, later, the
# Ingestion Worker) — the driver needs these three discrete values, not the
# combined NEO4J_AUTH form above. Keep the password in sync with NEO4J_AUTH.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_local_only

# --- Redis (redis:7.4-alpine) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- SQS via LocalStack (localstack/localstack:3.8) ---
# SQS_ENDPOINT_URL unset/empty targets real AWS SQS (prod path); set it locally so the
# Python worker fleet talks to LocalStack instead. AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# are dummy values — LocalStack accepts any non-empty string, never real credentials.
AWS_REGION=us-east-1
SQS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- SQS queue-name defaults (see services/workers/messaging/sqs_client.py) ---
SQS_INGESTION_QUEUE=ingestion
SQS_ENRICHMENT_QUEUE=enrichment
SQS_GRAPH_EVENTS_QUEUE=graph-events
SQS_SELFTEST_QUEUE=w0-04-selftest

# --- Vector-store metrics (W0-06) ---
# Exporter is swappable without touching call sites: prometheus | console | none (otlp = prod extension point)
OTEL_METRICS_EXPORTER=prometheus
METRICS_PORT=9464
METRICS_ADDR=0.0.0.0

# --- Graph-store metrics (W0-08) ---
# No new variables required: the synthetic-load script's real Neo4j driver reuses
# NEO4J_URI/NEO4J_USER/NEO4J_PASSWORD above (via neo4j_driver_from_env()), and the
# graph metrics ride the SAME shared OTEL_METRICS_EXPORTER/METRICS_PORT/METRICS_ADDR
# provider as the vector-store metrics (one MeterProvider, one /metrics server).
