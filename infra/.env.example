# Local datastore credentials template — placeholders only, no real secrets.
# Per .claude/rules/security-multitenancy.md: secrets (GitHub App keys, Jira/Linear
# OAuth tokens, etc.) never live in a config file like this one — this file only
# seeds local dev containers with non-production placeholder values.

# --- Postgres (pgvector/pgvector:pg16) ---
POSTGRES_USER=sayre_dev
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=sayre_dev

# --- Neo4j (neo4j:5.24-community) ---
# Format: <username>/<password>
NEO4J_AUTH=neo4j/changeme_local_only

# --- Redis (redis:7.4-alpine) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
