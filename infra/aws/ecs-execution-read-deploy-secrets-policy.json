{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDeploySecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:codebase-ontology/database-runtime-url*",
        "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:codebase-ontology/neo4j-password*",
        "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:codebase-ontology/core/redis-password*",
        "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:codebase-ontology/core/github-app-private-key*",
        "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:codebase-ontology/core/github-app-client-secret*",
        "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:codebase-ontology/core/github-webhook-secret*",
        "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:codebase-ontology/workers/anthropic-api-key*"
      ]
    }
  ]
}
