# Force LF line endings for shell scripts regardless of platform/autocrlf settings.
# infra/localstack/init/ready.d/01-create-sqs-queues.sh (W0-04) runs inside a Linux
# container via a bind-mounted volume — a CRLF-mangled shebang line (`#!/bin/sh\r`)
# would break it on a Windows checkout with `core.autocrlf=true`.
*.sh text eol=lf

# PL-03a: .claude/agents/*.md is generated by scripts/generate-agent-shims.mjs, which always
# writes LF. Without pinning this, a Windows checkout with core.autocrlf=true would convert the
# checked-out file to CRLF, and `generate-agent-shims.mjs --check` (freshly generated content is
# always LF) would report every shim as stale on Windows even with no real drift — or the reverse
# false-negative on a system where autocrlf silently normalizes back to LF on comparison.
.claude/agents/*.md text eol=lf

# PL-03c: .sdd/ledger/index.json is generated by scripts/build-ledger-index.mjs, which always
# writes LF, for the same cross-platform --check byte-stability reason as the shim rule above.
.sdd/ledger/index.json text eol=lf

# The permissions.deny half of .claude/settings.json is generated by
# scripts/generate-secret-denylist.mjs, which always writes LF — same --check byte-stability
# reason as the two rules above. Without this pin, `npm run check:agent-ignore` reports the
# settings file as stale on any Windows checkout with core.autocrlf=true, and a check that
# cries wolf on a clean tree is a check people learn to ignore.
.claude/settings.json text eol=lf
